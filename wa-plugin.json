{
  "schemaVersion": 3,
  "memberSubscriptions": [
    {
      "id": "updates",
      "kind": "internal",
      "scope": "community",
      "labelKey": "official.onboarding.subscription.title",
      "serviceId": "official.onboarding.subscriptions.v1",
      "choices": [
        {
          "id": "off",
          "labelKey": "official.onboarding.subscription.off"
        },
        {
          "id": "on",
          "labelKey": "official.onboarding.subscription.on"
        }
      ]
    }
  ],
  "pluginId": "official.onboarding",
  "name": "Onboarding & Updates",
  "author": {
    "name": "Batestinha",
    "url": "https://github.com/Batestinha"
  },
  "description": "Welcomes newcomers with group rules and a guide to available commands. Administrators publish editions that members can read with /updates or subscribe to receive privately.",
  "kind": "managed_group",
  "version": "0.3.0",
  "coreApiRange": "^0.3.32",
  "entrypoint": "dist/index.js",
  "messageNamespace": "official.onboarding",
  "descriptionKey": "official.onboarding.description",
  "commands": [
    "/updates",
    "/onboarding preview",
    "/onboarding status",
    "/onboarding resend",
    "/onboarding catch-up"
  ],
  "help": {
    "featureId": "onboarding",
    "titleKey": "official.onboarding.help.feature.title",
    "summaryKey": "official.onboarding.help.feature.summary",
    "order": 15,
    "aliases": [
      "Welcome and rules",
      "Boas-vindas e regras",
      "Onboarding",
      "welcome",
      "boas-vindas",
      "onboarding"
    ],
    "topics": [
      {
        "topicId": "scope-updates",
        "titleKey": "official.onboarding.help.updates.title",
        "summaryKey": "official.onboarding.help.cmd.updates",
        "order": 15,
        "commands": [
          "/updates"
        ],
        "instructionKeys": [
          "official.onboarding.editions.invitation"
        ],
        "exampleKeys": [
          "official.onboarding.help.updates.example"
        ],
        "keywords": [
          "updates",
          "novidades"
        ],
        "availability": {
          "invocation": "either",
          "requiresCurrentManagedGroupMembership": true,
          "currentManagedGroupMembershipMode": "effective_scope"
        }
      },
      {
        "topicId": "manage-onboarding",
        "titleKey": "official.onboarding.help.manage.title",
        "summaryKey": "official.onboarding.help.manage.summary",
        "order": 20,
        "commands": [
          "/onboarding preview",
          "/onboarding status",
          "/onboarding resend",
          "/onboarding catch-up"
        ],
        "instructionKeys": [
          "official.onboarding.help.manage.instruction"
        ],
        "exampleKeys": [
          "official.onboarding.help.manage.example"
        ],
        "keywords": [
          "welcome",
          "newcomer",
          "onboarding"
        ],
        "availability": {
          "invocation": "either",
          "permission": "plugin.onboarding.manage"
        }
      }
    ]
  },
  "eventSubscriptions": [
    "participant.change",
    "plugin.job"
  ],
  "requiredPermissions": [
    "plugin.onboarding.manage"
  ],
  "requiredBotCapabilities": [],
  "dangerousActions": [],
  "backgroundJobs": [
    "catch-up.batch",
    "updates.batch",
    "scope.configuration.changed",
    "scope.help.changed"
  ],
  "databases": [
    {
      "name": "onboarding",
      "engine": "sqlite",
      "scope": "account",
      "migrations": "migrations/onboarding"
    }
  ],
  "dataVersion": "2",
  "cancellation": {
    "workflows": []
  },
  "dependencies": [],
  "integrations": [
    {
      "pluginId": "official.community-admin",
      "versionRange": ">=1.1.0",
      "description": "Communicates the published group rules in welcomes and update drafts."
    }
  ],
  "assistant": {
    "summary": "Welcomes people once, on their first arrival in a scope (a community or standalone groups): a private welcome with the rules, a guide built from /help, and an optional account invitation.",
    "useCases": [
      "Welcome newcomers privately, once per scope, never again when they join another group of it.",
      "Read published updates with /updates or subscribe with /updates on.",
      "Include the group rules published by Group Administration Assistant in welcomes.",
      "Preview the welcome or send it again to someone.",
      "Once, send a paced late welcome to everyone who was here before onboarding started."
    ],
    "prerequisites": [
      "enabled=true in the target scope.",
      "Groups in ASSIST or MANAGE mode, so the bot may send messages.",
      "WABP core API 0.3.30 or later for update delivery receipts and member topic IDs."
    ],
    "limitations": [
      "Current members are recorded when it starts and are never welcomed.",
      "People added back by the bot (for example after a suspension) get nothing.",
      "Group history is sent separately, per group, by Archive Courier."
    ],
    "workflows": [
      {
        "intent": "onboarding_manage",
        "description": "Preview, count or resend the welcome.",
        "commands": [
          "/onboarding preview",
          "/onboarding status",
          "/onboarding resend"
        ]
      },
      {
        "intent": "onboarding_catch_up",
        "description": "Send the late welcome to people who were already here, once and paced.",
        "commands": [
          "/onboarding catch-up"
        ]
      }
    ]
  },
  "services": [
    {
      "serviceId": "official.onboarding.delivery.v1",
      "methods": [
        {
          "name": "allowDelivery",
          "access": "read",
          "timeoutMs": 60000
        }
      ]
    },
    {
      "serviceId": "official.onboarding.subscriptions.v1",
      "methods": [
        {
          "name": "read",
          "access": "read"
        },
        {
          "name": "set",
          "access": "mutation"
        }
      ]
    }
  ],
  "externalActions": [
    {
      "actionId": "official.onboarding.editionState",
      "access": "read",
      "description": "Preview the current edition and eligible subscriber count",
      "scope": "scope",
      "timeoutMs": 60000
    },
    {
      "actionId": "official.onboarding.editEdition",
      "access": "mutation",
      "description": "Save, dismiss or publish the reviewed edition",
      "scope": "scope",
      "timeoutMs": 60000
    }
  ],
  "consoleOperations": [
    {
      "operationId": "official.onboarding.editionState",
      "access": "read",
      "authorization": "operator",
      "description": "Preview the current edition and eligible subscriber count"
    },
    {
      "operationId": "official.onboarding.editEdition",
      "access": "mutation",
      "authorization": "operator",
      "description": "Save, dismiss or publish the reviewed edition"
    }
  ],
  "operatorConsole": {
    "configPaths": [
      "enabled",
      "exemptGroupChatIds",
      "welcome.text",
      "guide.enabled",
      "guide.maxEntries",
      "guide.includeFamilies",
      "guide.excludeFamilies",
      "invitation.enabled",
      "invitation.text",
      "invitation.skipLinked",
      "catchUp.intro",
      "catchUp.batchSize",
      "catchUp.intervalMinutes",
      "catchUp.sendFrom",
      "catchUp.sendUntil",
      "welcomeBack.enabled",
      "welcomeBack.text",
      "welcomeBack.minAbsenceDays"
    ],
    "controls": [
      {
        "pluginId": "official.onboarding",
        "id": "plugin.official.onboarding.enabled",
        "path": "enabled",
        "label": "Enable onboarding and updates",
        "description": "Welcome newcomers and manage update editions in this scope.",
        "section": "Updates",
        "order": 10,
        "schema": {
          "type": "boolean"
        },
        "ui": {
          "widget": "builder",
          "helpText": "Preview the member message and eligible audience before publishing an update.",
          "builderId": "official.onboarding.editions.v1",
          "builderEndpoints": {
            "state": "/api/v1/plugins/official.onboarding/:scopeId/editions",
            "edit": "/api/v1/plugins/official.onboarding/:scopeId/editions"
          }
        }
      },
      {
        "pluginId": "official.onboarding",
        "id": "plugin.official.onboarding.welcome.text",
        "path": "welcome.text",
        "label": "Welcome",
        "description": "The first private message a newcomer receives. Leave empty to use the default welcome.",
